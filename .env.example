# Copy to .env; never commit passwords.
# When running camera agents on other laptops, use the MQTT host's LAN IP.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=skywatch
MQTT_PASSWORD=replace-with-local-secret

# Example approximate center; set your actual observation coordinates.
ADSB_LATITUDE=51.1
ADSB_LONGITUDE=17.03
ADSB_RADIUS_NM=30
ADSB_POLL_SECONDS=15

# Planned backend setting; backend is not yet implemented.
DATABASE_URL=sqlite:///./skywatch.db
