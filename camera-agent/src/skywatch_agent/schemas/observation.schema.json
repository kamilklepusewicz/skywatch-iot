{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkyWatch observation v1",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "camera_id",
    "captured_at",
    "object_type",
    "confidence",
    "bbox",
    "mode"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "camera_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "object_type": {
      "type": "string",
      "enum": [
        "airplane",
        "bird",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "Normalized [x, y, width, height]"
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "replay"
      ]
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "track_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
