# Skopiuj do .env.docker i wpisz dane używane przez Mosquitto.
MQTT_USERNAME=skywatch
MQTT_PASSWORD=

# Opcjonalne ustawienia. Dla LIVE podaj obie współrzędne obszaru obserwacji.
# ADSB_ENABLED=false
# ADSB_LATITUDE=
# ADSB_LONGITUDE=
# ADSB_RADIUS_NM=30
# ADSB_POLL_SECONDS=180
# ADSB_API_KEY=
# CAMERA_IDS=["camera_1","camera_2"]
# CAMERA_LOCATIONS={}
# DATABASE_PATH=/data/skywatch.sqlite3
