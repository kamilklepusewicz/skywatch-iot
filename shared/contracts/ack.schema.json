{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkyWatch command ACK v1",
  "type": "object",
  "required": [
    "schema_version",
    "command_id",
    "camera_id",
    "reported_at",
    "accepted"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "camera_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    }
  }
}
